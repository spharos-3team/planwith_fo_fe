# Server-side proxy target used by src/app/api/v1/[...path]/route.ts.
# Not exposed to the browser (no NEXT_PUBLIC_ prefix).
#
# Local (127.0.0.1 avoids Windows localhost → IPv6 hang-up):
#   GATEWAY_URL=http://127.0.0.1:8000
# If this PC has no schedule service, point GATEWAY_URL at the team Gateway.
# Vercel (Dashboard → Settings → Environment Variables, Production/Preview):
#   GATEWAY_URL=https://<AWS-GATEWAY-DOMAIN>
#   If the AWS Gateway is still HTTP-only, use http://<AWS-GATEWAY-HOST>:8000
#   Do not commit the real host here.
GATEWAY_URL=http://127.0.0.1:8000

# Browser API prefix. Keep this as a same-origin path.
# The browser calls /api/v1, Next.js Route Handler proxies to GATEWAY_URL.
#
# Do not point this at the AWS Gateway from a HTTPS Vercel deploy.
# That would be a cross-origin call and, if Gateway is HTTP, mixed content.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Browser WebSocket cannot use the Next.js HTTP proxy.
# Unset: Next `/api/chat-stomp-url` uses GATEWAY_URL (ws://<gateway>/api/v1/chat/ws).
# Override only when the browser must use a different host than GATEWAY_URL.
NEXT_PUBLIC_WS_BASE_URL=

# 소셜 로그인 (없으면 버튼 클릭 시 안내 메시지)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_NAVER_CLIENT_ID=
NEXT_PUBLIC_KAKAO_CLIENT_ID=

# 콘솔 Callback / Redirect URI 는 슬래시 없이 정확히 이것만 등록
# http://localhost:3000/auth/callback/google
# http://localhost:3000/auth/callback/naver
# http://localhost:3000/auth/callback/kakao
# 서비스 URL / JavaScript origin: http://localhost:3000
# 127.0.0.1 로 열면 localhost 와 다른 주소라 따로 등록해야 함
